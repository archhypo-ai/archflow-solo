OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional structured request-router model. Set to an OpenRouter model that
# supports the decisions contract; the graph does not select providers by name.
# SYSTEM_ONE_MODEL=provider/model
# SYSTEM_ONE_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# SYSTEM_ONE_TIMEOUT=30
TAVILY_API_KEY=

# Optional LangSmith tracing:
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=archhypo-flow

# Optional Langfuse tracing (install the observability extra):
# LANGFUSE_ENABLED=false
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
