OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter:deepseek/deepseek-v4.1-flash
# Optional OpenRouter attribution headers:
# OPENROUTER_HTTP_REFERER=http://localhost
# OPENROUTER_APP_NAME=ArchWise
# Optional absolute or monorepo-relative local storage directory:
# ARCHWISE_STORAGE_ROOT=.archhypo

# Optional LangSmith tracing:
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=archwise

# Optional Langfuse tracing (install the observability extra):
# LANGFUSE_ENABLED=false
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
